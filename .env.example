# =======================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA NACIONAL ESAVI
# =======================================================
# Copia este archivo como .env y completa los valores correspondientes
# NUNCA compartas ni subas el archivo .env con valores reales a repositorios públicos.

# Integraciones de API y Modo de Operación
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/EJEMPLO/exec
VITE_USE_API=true
VITE_BASE_PATH=/
VITE_ROUTER_MODE=hash
VITE_DATA_PROVIDER=firebase

# Firebase Configuration (Entorno de Pruebas / Transición)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Almacenamiento de Evidencias y Recursos Visuales (Pruebas)
VITE_CLOUDINARY_CLOUD_NAME=nombre_cloud
VITE_CLOUDINARY_UPLOAD_PRESET=nombre_preset
VITE_LOGIN_BG_URL=https://ejemplo.local/fondo_institucional.png
VITE_PLANTILLA_ANEXO_URL=https://ejemplo.local/plantilla_anexo.pdf

# =======================================================
# VARIABLES OBJETIVO PRODUCCIÓN SRS (GCP / BACKEND)
# =======================================================
# En producción estas variables se inyectan vía Secret Manager
API_BASE_URL=https://api.dev.srs.gob.sv/api/v1
KEYCLOAK_URL=https://auth.srs.gob.sv
KEYCLOAK_REALM=srs-esavi
KEYCLOAK_CLIENT_ID=esavi-web
GCS_BUCKET_NAME=srs-esavi-evidencias-prod
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
GCP_PROJECT_ID=proy-srs-esavi
GCP_REGION=us-central1
