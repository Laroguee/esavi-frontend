# =======================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA NACIONAL ESAVI
# =======================================================
# Copia este archivo como .env y completa los valores correspondientes
# NUNCA compartas ni subas el archivo .env con valores reales a repositorios públicos.

# Integraciones de API y Modo de Operación
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/EJEMPLO/exec
VITE_USE_API=true
VITE_BASE_PATH=/

# Firebase Configuration (Credenciales de Proyecto Institucional)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Almacenamiento de Evidencias Clínicas (Fotos, PDFs, Fichas)
VITE_CLOUDINARY_CLOUD_NAME=nombre_cloud
VITE_CLOUDINARY_UPLOAD_PRESET=nombre_preset

